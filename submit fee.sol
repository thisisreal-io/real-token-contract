pragma solidity ^0.8.28;

import {ReentrancyGuard} from "@openzeppelin/contracts@5.2.0/utils/ReentrancyGuard.sol";

interface IERC20Burnable {
    function burnFrom(address account, uint256 amount) external;
    function balanceOf(address account) external view returns (uint256);
    function allowance(address owner, address spender) external view returns (uint256);
}

contract SubmitFee is ReentrancyGuard {
    IERC20Burnable public immutable REAL_TOKEN;

    uint256 public constant SUBMISSION_FEE = 1 * 10 ** 18; // 1 REAL (18 decimals)

    mapping(bytes32 => bool) public usedBackendIds;

    constructor(address realToken) {
        require(realToken != address(0), "SubmitFee: Token address cannot be zero");
        REAL_TOKEN = IERC20Burnable(realToken);
    }

    enum SubmissionType {
        Property,
        Forum,
        Poll
    }

    event Submitted(
        address indexed submitter,
        SubmissionType indexed submissionType,
        bytes32 indexed backendId,
        string title
    );

    /**
     * @dev Submit a property, forum thread, or poll.
     *      Burns 1 REAL from the caller's wallet.
     *      The caller must have previously approved this contract
     *      to spend at least 1 REAL on the REAL token contract.
     * @param submissionType The type of submission (0 = Property, 1 = Forum, 2 = Poll)
     * @param title The title of the submission
     * @param backendId A unique identifier generated by the backend (each ID can only be used once) (each ID can only be used once)
     */
    function submit(
        SubmissionType submissionType,
        string calldata title,
        bytes32 backendId
    ) external nonReentrant {
        require(bytes(title).length > 0, "SubmitFee: Title cannot be empty");
        require(backendId != bytes32(0), "SubmitFee: Backend ID cannot be zero");
        require(!usedBackendIds[backendId], "SubmitFee: Backend ID already used");
        require(
            REAL_TOKEN.balanceOf(msg.sender) >= SUBMISSION_FEE,
            "SubmitFee: Insufficient REAL balance"
        );
        require(
            REAL_TOKEN.allowance(msg.sender, address(this)) >= SUBMISSION_FEE,
            "SubmitFee: Insufficient allowance, approve this contract on REAL token first"
        );

        usedBackendIds[backendId] = true;

        REAL_TOKEN.burnFrom(msg.sender, SUBMISSION_FEE);

        emit Submitted(msg.sender, submissionType, backendId, title);
    }
}
